<!--
  MyPods MSI (WiX v5). Built by .github/workflows/windows.yml:
    wix build packaging/windows/MyPods.wxs -arch x64 -d Version=1.0.N -d DeployDir=deploy -o MyPods-x64.msi
  1.0.N is the version the app shows (CMakeLists.txt). DeployDir is mypods.exe after windeployqt, with the daemon in modules\.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The UpgradeCode never changes: it is how a newer MSI finds and replaces an older install -->
  <Package Name="MyPods" Manufacturer="MyPods" Version="$(Version)" Scope="perMachine"
           UpgradeCode="4C040DE7-72B0-401B-B2A2-71364E7ED02D">
    <!-- After the new files are in: the audio engine holds EqualizerAPO.dll, and an unchanged one is then kept instead
         of removed and copied again, which would wait for a reboot -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of MyPods is already installed." Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MyPodsIcon" SourceFile="ui\src\app\mypods.ico" />
    <Property Id="ARPPRODUCTICON" Value="MyPodsIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HanreichC/MyPods" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MyPods">
        <Files Include="$(DeployDir)\**" />

        <!-- Equalizer APO's engine for the effects (EqualizerAPO\, from the deploy folder). The daemon, running as the
             user, writes its config here, and the audio engine (Local Service) reads it -->
        <Directory Id="EqualizerApoFolder" Name="EqualizerAPO">
          <Directory Id="ApoConfigFolder" Name="config">
            <Component Id="ApoConfig" Guid="6BEA03B2-32BE-4A88-B80F-ED99049739E2">
              <CreateFolder>
                <PermissionEx Sddl="D:AI(A;OICI;0x1301bf;;;BU)(A;OICI;FR;;;LS)(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
              </CreateFolder>
              <RemoveFile Id="ApoConfigFiles" Name="*.txt" On="uninstall" />
            </Component>
          </Directory>
        </Directory>

        <!-- Starts hidden in the tray at login, like the autostart entry install.sh writes on Linux -->
        <Component Id="Autostart">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="MyPods"
                         Type="string" Value="&quot;[INSTALLFOLDER]mypods.exe&quot; --hidden" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="MyPodsShortcut" Name="MyPods" Description="The control center for your Bluetooth headphones"
                  Target="[INSTALLFOLDER]mypods.exe" WorkingDirectory="INSTALLFOLDER" Icon="MyPodsIcon" />
        <RegistryValue Root="HKLM" Key="Software\MyPods" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Equalizer APO on the headphone endpoints, and off them again (AudioEffects_win.cpp). Without it MyPods
         still works, only without effects, so a failure doesn't stop the install. An upgrade keeps it on. -->
    <CustomAction Id="ApoInstall" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]modules\mypodscore.exe&quot; --apo-install" />
    <CustomAction Id="ApoUninstall" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]modules\mypodscore.exe&quot; --apo-uninstall" />
    <!-- MyPods ends before its files change (also the magicpods*.exe it was called before): the daemon has no window
         that Windows could ask to close, and a running one would keep the port the new one needs -->
    <CustomAction Id="StopMyPods" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM mypods.exe /IM mypodscore.exe /IM magicpods.exe /IM magicpodscore.exe" />
    <InstallExecuteSequence>
      <Custom Action="StopMyPods" Before="InstallFiles" />
      <Custom Action="ApoInstall" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="ApoUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
