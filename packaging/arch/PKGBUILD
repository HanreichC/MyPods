# Arch Linux package, built from the latest commit on main (AUR-style -git package):
#   cd packaging/arch && makepkg -si
# The daemon runs as a systemd user service; enable it once per user:
#   systemctl --user enable --now mypods-core.service
pkgname=mypods-git
pkgver=0.2.0
pkgrel=1
pkgdesc="AirPods and other Bluetooth headphones on Linux the way they feel on a Mac"
arch=(x86_64 aarch64)
url="https://github.com/HanreichC/MyPods"
license=(GPL-3.0-only)
depends=(bluez bluez-libs libpulse openssl systemd-libs qt6-base qt6-declarative qt6-websockets qt6-svg)
makedepends=(cmake git qt6-tools)
optdepends=('pipewire-pulse: the sound server the daemon talks to'
            'libmysofa: spatial audio'
            'layer-shell-qt: tray popup placed under the panel on Wayland')
provides=(mypods)
conflicts=(mypods)
source=("MyPods::git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd MyPods
    # v0.2.0-3-gabc1234 -> 0.2.0.r3.gabc1234; without a tag, the version from CMakeLists.txt
    if described=$(git describe --long --tags --match 'v*' 2>/dev/null); then
        echo "$described" | sed 's/^v//;s/-/.r/;s/-/./'
    else
        printf '%s.r%s.g%s' "$(sed -n 's/^project(mypods VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)" \
            "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

build() {
    cmake -S MyPods -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build
}

check() {
    build/modules/magicpodscore --selftest
}

package() {
    # the UI finds the daemon in modules/ next to its own (real) path
    install -Dm755 build/magicpods "$pkgdir/usr/lib/mypods/magicpods"
    install -Dm755 build/modules/magicpodscore "$pkgdir/usr/lib/mypods/modules/magicpodscore"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/mypods/magicpods "$pkgdir/usr/bin/magicpods"
    ln -s /usr/lib/mypods/modules/magicpodscore "$pkgdir/usr/bin/magicpodscore"
    install -Dm644 MyPods/packaging/linux/app.magicpods.desktop "$pkgdir/usr/share/applications/app.magicpods.desktop"
    install -Dm644 MyPods/packaging/linux/mypods-core.service "$pkgdir/usr/lib/systemd/user/mypods-core.service"
    install -Dm644 MyPods/ui/src/app/qml/assets/images/logo-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/magicpods.png"
}
