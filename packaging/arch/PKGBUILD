# Arch Linux package, built from the latest commit on main (AUR-style -git package):
#   cd packaging/arch && makepkg -si
# The daemon runs as a systemd user service; enable it once per user:
#   systemctl --user enable --now mypods-core.service
pkgname=mypods-git
pkgver=0.2.0
pkgrel=1
pkgdesc="AirPods and other Bluetooth headphones on Linux the way they feel on a Mac"
arch=(x86_64 aarch64)
url="https://github.com/HanreichC/MyPods"
license=(GPL-3.0-only)
depends=(bluez bluez-libs libpulse openssl systemd-libs qt6-base qt6-declarative qt6-websockets qt6-svg)
makedepends=(cmake git qt6-tools qt6-shadertools)
optdepends=('pipewire-pulse: the sound server the daemon talks to'
            'libmysofa: spatial audio'
            'swh-plugins: lookahead limiter, spatial audio 7 dB louder'
            'layer-shell-qt: tray popup placed under the panel on Wayland'
            'kwindowsystem: tray popup and lid popup as glass over the blurred desktop on KDE')
provides=(mypods)
conflicts=(mypods)
source=("MyPods::git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd MyPods
    # The same version the app shows (CMakeLists.txt): MAJOR.MINOR plus the commits since it was set
    printf '%s.%s' "$(sed -n 's/^project(mypods VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)" \
        "$(git rev-list --count "$(git log -1 --format=%H -G'^project.mypods VERSION' -- CMakeLists.txt)"..HEAD)"
}

build() {
    cmake -S MyPods -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build
}

check() {
    build/modules/mypodscore --selftest
}

package() {
    # the UI finds the daemon in modules/ next to its own (real) path
    install -Dm755 build/mypods "$pkgdir/usr/lib/mypods/mypods"
    install -Dm755 build/modules/mypodscore "$pkgdir/usr/lib/mypods/modules/mypodscore"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/mypods/mypods "$pkgdir/usr/bin/mypods"
    ln -s /usr/lib/mypods/modules/mypodscore "$pkgdir/usr/bin/mypodscore"
    install -Dm644 MyPods/packaging/linux/app.mypods.desktop "$pkgdir/usr/share/applications/app.mypods.desktop"
    install -Dm644 MyPods/packaging/linux/mypods-core.service "$pkgdir/usr/lib/systemd/user/mypods-core.service"
    install -Dm644 MyPods/ui/src/app/qml/assets/images/logo-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/mypods.png"
}
